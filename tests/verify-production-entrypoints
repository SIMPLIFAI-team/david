#!/usr/bin/env bash
set -euo pipefail

workflow=".github/workflows/portmason-setup-and-deploy.yml"

if [[ ! -r "$workflow" ]]; then
  echo "Missing Portmason publication workflow: $workflow" >&2
  exit 1
fi

grep -Fq 'OPS_AND_SOPS_READ_TOKEN: ${{ secrets.OPS_AND_SOPS_READ_TOKEN }}' "$workflow" || {
  echo "The Pages workflow does not use David's Portmason checkout secret." >&2
  exit 1
}

grep -Fq 'DEPLOY_DIR: site/deploy/prd' "$workflow" || {
  echo "The Pages workflow does not define the production deployment directory." >&2
  exit 1
}

grep -Fq 'PAGES_SITE_DIR: site/deploy/prd/www' "$workflow" || {
  echo "The Pages workflow does not define the production publication directory." >&2
  exit 1
}

grep -Fq 'working-directory: ${{ env.DEPLOY_DIR }}' "$workflow" || {
  echo "The Pages workflow does not run Portmason from the production deployment directory." >&2
  exit 1
}

grep -Fq 'path: ${{ env.PAGES_SITE_DIR }}' "$workflow" || {
  echo "The Pages workflow does not upload the production deployment artifact." >&2
  exit 1
}

printf 'Deployment-snapshot Portmason publication entrypoints are ready.\n'
