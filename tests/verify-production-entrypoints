#!/usr/bin/env bash
set -euo pipefail

workflow=".github/workflows/portmason-setup-and-deploy.yml"

if [[ ! -r "$workflow" ]]; then
  echo "Missing Portmason publication workflow: $workflow" >&2
  exit 1
fi

grep -Fq 'ref_file=".portmason-tooling-ref"' "$workflow" || {
  echo "The Pages workflow does not validate its pinned Portmason revision." >&2
  exit 1
}

grep -Fq 'working-directory: ${{ env.PROJECT_DIR }}' "$workflow" || {
  echo "The Pages workflow does not run from the project root." >&2
  exit 1
}

grep -Fq 'PM_DEPLOY_ENV: prd' "$workflow" || {
  echo "The Pages workflow does not identify the official production environment." >&2
  exit 1
}

grep -Fq 'path: ${{ steps.publication.outputs.path }}' "$workflow" || {
  echo "The Pages workflow does not upload Portmason's resolved publication directory." >&2
  exit 1
}

if grep -Eq 'DEPLOY_DIR|PAGES_SITE_DIR|site/deploy/prd' "$workflow"; then
  echo "The Pages workflow still depends on the legacy deployment snapshot." >&2
  exit 1
fi

printf 'Pinned root-built Portmason publication entrypoints are ready.\n'
