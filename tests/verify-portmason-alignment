#!/usr/bin/env bash
set -euo pipefail

required=(
  .portmason-tooling-ref
  .github/workflows/portmason-setup-and-deploy.yml
  mgt-scripts/setup
  www/index.html
  www/collections/_system/render-collection
)

for path in "${required[@]}"; do
  [[ -e "$path" ]] || {
    echo "Missing required path: $path" >&2
    exit 1
  }
done

tooling_ref="$(tr -d '[:space:]' < .portmason-tooling-ref)"
[[ "$tooling_ref" =~ ^[0-9a-f]{40}$ ]] || {
  printf 'Invalid Portmason tooling revision: %s\n' "$tooling_ref" >&2
  exit 1
}

printf 'Current root-built Portmason site alignment is present.\n'
