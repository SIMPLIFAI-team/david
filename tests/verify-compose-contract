#!/usr/bin/env bash
set -euo pipefail

readonly ROOT_COMPOSE="docker-compose.yml"
readonly PRD_COMPOSE="deploy/prd/docker-compose.yml"
readonly COMPOSE_FILES=("${ROOT_COMPOSE}" "${PRD_COMPOSE}")

for compose_file in "${COMPOSE_FILES[@]}"; do
  if [[ ! -f "${compose_file}" ]]; then
    printf 'ERROR: required Compose file not found: %s\n' "${compose_file}" >&2
    exit 1
  fi

  if grep -nE '^[[:space:]]*-[[:space:]]+[^#]+:[[:space:]]*["'"'"']\$?\{?/?' "${compose_file}" >/dev/null; then
    printf 'ERROR: ambiguous quoted short volume syntax in %s\n' "${compose_file}" >&2
    grep -nE '^[[:space:]]*-[[:space:]]+[^#]+:[[:space:]]*["'"'"']\$?\{?/?' "${compose_file}" >&2
    exit 1
  fi

  if ! grep -qE '^[[:space:]]*-[[:space:]]+type:[[:space:]]+bind[[:space:]]*$' "${compose_file}"; then
    printf 'ERROR: %s must use long bind-mount syntax\n' "${compose_file}" >&2
    exit 1
  fi

done

if ! grep -qE '^[[:space:]]+target:[[:space:]]+\$\{CONTAINER_ROOT\}[[:space:]]*$' "${ROOT_COMPOSE}"; then
  printf 'ERROR: root toolbox target must be ${CONTAINER_ROOT}\n' >&2
  exit 1
fi

if ! grep -qE '^[[:space:]]+target:[[:space:]]+\$\{CONTAINER_ROOT\}[[:space:]]*$' "${PRD_COMPOSE}"; then
  printf 'ERROR: production toolbox target must be ${CONTAINER_ROOT}\n' >&2
  exit 1
fi

printf 'Compose bind-mount contract verified.\n'
