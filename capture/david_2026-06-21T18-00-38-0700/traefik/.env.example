DEPLOY_ENV=dev
APP_SLUG=traefik
PROJECT_ID=traefik
RUNTIME_ADAPTER_CODE=traefik-local

# Generally, you should NOT modify anything below this line.
# However, PLEASE review everything below this line and identify any values that deem require modification
#--------------------------------------------------

# These will be derived and persisted by sys- setup scripts
STACK=${APP_SLUG}-${DEPLOY_ENV}
DEPLOYMENT_ID=

# These vars usually keep their default value
LOCAL_DOMAIN=localtest.me

# Tooling
APP_HOST=${STACK}.${LOCAL_DOMAIN}
TRAEFIK_DIR=$HOME/code/traefik

URI_SCHEME=http:
SITE_URL="$URI_SCHEME//$APP_HOST"

GODADDY_API_KEY=h1JwmTAXHeGS_62XLqDufoBKew86RqQuEPT
GODADDY_API_SECRET=VErqZp9xriu7c1CiBbdBQg
ACME_EMAIL=certs@etal.solutions
# optional but helps with slower DNS propagation:
GODADDY_TTL=600
GODADDY_PROPAGATION_TIMEOUT=180
GODADDY_POLLING_INTERVAL=5

# ------------------------------
# Et al Solutions – EPC Tag Contract
# ------------------------------

CLIENT=etalsolutions

# Ownership (logical, not personal)
OWNER_ALIAS=etalsolutions             # Allowed: etalsolutions | client-it | client-dev | vendor | other

# Control plane
MANAGED_BY=compose                    # Allowed: compose | k8s | terraform | manual | other

# Container lifecycle
LIFECYCLE=long-lived                  # Allowed: ephemeral | long-lived | job

# Data governance
DATA_CLASS=confidential               # Allowed: public | internal | confidential | regulated
DATA_LIFECYCLE=persistent             # Allowed: transient | persistent | archival


