name: ${STACK}
services:
  traefik:
    image: traefik:v3.7.5
    restart: unless-stopped
    command:
    # Providers
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=proxy"

      # API & Dashboard (dev only)
      - "--api=true"
      - "--api.dashboard=true"
      - "--api.insecure=true"

      # Access log (EPC: Observability by Convention)
      - "--accesslog=true"
      - "--log.level=${LOG_LEVEL}"
      - "--accesslog.format=${LOG_FORMAT}"
      - "--accesslog.filepath=/var/log/traefik/access.log"
      - "--accesslog.bufferingsize=100"
      - "--accesslog.fields.defaultmode=keep"
      - "--accesslog.fields.names.StartUTC=drop"
      - "--accesslog.fields.headers.defaultmode=keep"
      - "--accesslog.fields.headers.names.X-Forwarded-For=keep"
      - "--accesslog.fields.headers.names.X-Real-Ip=keep"
      - "--accesslog.fields.headers.names.X-Stack=keep"
      - "--accesslog.fields.headers.names.Authorization=redact"
      - "--accesslog.fields.headers.names.Cookie=redact"

      # General log
      - "--log.level=${LOG_LEVEL}"
      - "--log.format=${LOG_FORMAT}"
      - "--log.filepath=/var/log/traefik/traefik.log"
    ports:
       - "80:80"  # browse http://traefik.localtest.me
       - "443:443"  # browse https://traefik.localtest.me
    networks:
      - proxy
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/traefik.yml:ro
      - ./dynamic:/dynamic:ro
      - ./certs:/certs:ro
    labels:
      traefik.enable: "true" # not required for file-provider routers, but harmless

      # Dashboard router
      traefik.http.routers.${STACK}-dashboard.rule: "Host(`${APP_HOST}`)"
      traefik.http.routers.${STACK}-dashboard.entrypoints: "web"
      traefik.http.routers.${STACK}-dashboard.service: "api@internal"

      solutions_etal_service: ${STACK}
      solutions_etal_service_tier: ${DEPLOY_ENV}
      solutions_etal_managed_by: ${MANAGED_BY}
      solutions_etal_service_lifecycle: ${LIFECYCLE}
      solutions_etal_project_id: ${PROJECT_ID}
      solutions_etal_stack: ${STACK}
      solutions_etal_client: ${CLIENT}
      solutions_etal_owner: ${OWNER_ALIAS}
      solutions_etal_data_class: ${DATA_CLASS}
      solutions_etal_data_lifecycle: ${DATA_LIFECYCLE}

networks:
  proxy:
    external: true
