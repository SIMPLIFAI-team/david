#!/usr/bin/env bash
# David site application setup. Portmason sources this during pm-setup.

david_site_setup_main() {
  local project_root site_dir installer provider

  project_root="${PROJECT_ROOT:-$(pwd)}"
  site_dir="${project_root}/www"
  provider="${PM_WEB_ANALYTICS_PROVIDER:-}"

  [[ -z "$provider" ]] && return 0
  [[ "$provider" == "google-tag-manager" ]] \
    || { printf 'ERROR: Unsupported David site analytics provider: %s\n' "$provider" >&2; return 2; }

  installer="$(command -v pm-install-web-analytics || true)"
  if [[ -z "$installer" && -x "${PORTMASON_SHARE:-}/pm-install-web-analytics" ]]; then
    installer="${PORTMASON_SHARE}/pm-install-web-analytics"
  fi
  [[ -x "$installer" ]] \
    || { printf 'ERROR: David site requires pm-install-web-analytics\n' >&2; return 2; }

  "$installer" \
    --site-dir "$site_dir" \
    --all-html \
    --site-name "David Park Omer"
}

david_site_setup_main "$@"
david_site_setup_rc=$?

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  exit "$david_site_setup_rc"
fi
return "$david_site_setup_rc"
