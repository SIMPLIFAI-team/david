# Portmason-managed local workspace material.
# The full /portmason stage is the explicit exception: pm-setup creates it and
# isolated runners such as GitHub Actions consume the committed stage.
/capture/
/archive/
/logs/
/www/logs/
.artifacts/

/portmason/
/portmason/**

# Downloaded build packages and Windows attachment metadata.
/*.tar.gz
/*-chg.txt
*:Zone.Identifier

# Local recovery and interpreter residue.
/.env.restore
*.bak
*.pyc
__pycache__/

# Keep generated Portmason contract files tracked.
!.env.generated
!config.generated.json

# Production synchronization state is local operational state.
/deploy/*/.pm-deploy-sync.*
