{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.david.simplifai.team/collections/_system/collection.schema.json",
  "title": "Portmason Collection Manifest",
  "type": "object",
  "required": ["id", "foundation", "mode", "layout", "dataFile", "styleFile", "region", "presentation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "foundation": {"const": "portmason.collections"},
    "mode": {"enum": ["case-study", "catalog"]},
    "layout": {"const": "grid"},
    "dataFile": {"type": "string"},
    "styleFile": {"type": "string"},
    "region": {"type": "string"},
    "presentation": {"type": "object"}
  },
  "additionalProperties": true
}
