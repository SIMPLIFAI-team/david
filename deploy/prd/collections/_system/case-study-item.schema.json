{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case Study Collection Item",
  "type": "object",
  "required": ["id", "published", "order", "tag", "title", "summary", "highlights", "url"],
  "properties": {
    "id": {"type": "string"},
    "published": {"type": "boolean"},
    "order": {"type": "integer", "minimum": 1},
    "tag": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "summaryHtml": {"type": "string"},
    "highlights": {"type": "array", "items": {"type": "string"}},
    "url": {"type": "string"}
  },
  "additionalProperties": false
}
